{
  "manifest_version": 3,
  "name": "Command Palette",
  "version": "1.0.0",
  "description": "A fast, keyboard-driven command palette for tabs, bookmarks, history, search and extensions.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "121",
  "permissions": [
    "tabs",
    "tabGroups",
    "bookmarks",
    "history",
    "search",
    "favicon",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "commands": {
    "toggle-palette": {
      "suggested_key": {
        "default": "Ctrl+K",
        "mac": "Command+K"
      },
      "description": "Open the command palette"
    }
  }
}
