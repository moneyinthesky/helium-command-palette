{
  "manifest_version": 3,
  "name": "Command Palette",
  "version": "0.1.0",
  "description": "A fast, keyboard-driven command palette for tabs, history, search and extensions.",
  "minimum_chrome_version": "121",
  "permissions": [
    "tabs",
    "history",
    "favicon",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "_favicon/*"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_dynamic_url": true
    }
  ],
  "commands": {
    "toggle-palette": {
      "suggested_key": {
        "default": "Ctrl+K",
        "mac": "Command+K"
      },
      "description": "Open the command palette"
    }
  }
}
